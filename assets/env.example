# Copy the lines you need into your shell. Do not commit real credentials.

# --- Network ---------------------------------------------------------------
# Conventional variables used by git, curl, pip, and SwiftPM.
# export http_proxy=http://127.0.0.1:7897
# export https_proxy=http://127.0.0.1:7897
# export all_proxy=socks5://127.0.0.1:7897

# xtool only: host:port, no scheme, no trailing slash.
# export XTL_HTTP_PROXY=127.0.0.1:7897

# Optional regional PyPI mirror.
# export PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# --- App Store Connect -----------------------------------------------------
# Keep the .p8 outside the repository.
# export ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
# export ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
# export ASC_KEY_ID="XXXXXXXXXX"

# --- Capabilities ----------------------------------------------------------
# Absolute path; the provisioning profile must grant the same capabilities.
# export APP_ENTITLEMENTS="/absolute/path/to/MyApp.entitlements"

# --- Toolchain overrides (optional) ---------------------------------------
# export SWIFT_VERSION=6.3.3
# export PREFIX="$HOME/.local/ubuntu-ios-toolchain"
# export SWIFT_PREFIX="$HOME/.local/swift-$SWIFT_VERSION"
# export UBUNTU_IOS_TOOLCHAIN_DIR="$HOME/src/ubuntu-ios-toolchain"
